{
    "manifest_version": 3,
    "name": "Watchkeep",
    "version": "0.1.0",
    "description": "Automatically remembers where you stopped watching.",
    "browser_specific_settings": {
        "gecko": {
            "id": "watchkeep@yourname",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ],
    "permissions": [
        "storage"
    ]
}